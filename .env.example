# Copy to .env and fill in. Never commit .env.
PORT=8787
# 127.0.0.1 when nginx (or another reverse proxy) on the same machine serves the app.
HOST=0.0.0.0
# Optional: key that signs staff sessions (32+ random characters, e.g. `openssl rand -base64 48`).
# Leave blank to have one generated and stored in the database.
AUTH_SECRET=
# Required to register the first till's staff with this server from outside the
# shop network (deploy.sh generates one). Without it, only LAN addresses may register.
SETUP_CODE=

# --- Server database (SQLite) ---
# Default: ./data/optimas.db next to package.json
DB_PATH=

# --- M-Pesa: PinnovaTech pay gateway (preferred) ---
# When PAY_ENDPOINT is set, /api/mpesa/stkpush prompts the customer's phone
# through this endpoint ({ phone, amount, reference }) and the outcome is
# polled from the status endpoint and stored in SQLite.
PAY_ENDPOINT=https://optimus.pinnovatech.co.ke/optimus/pay
# Defaults to PAY_ENDPOINT when blank. Send method: POST (default) or GET.
PAY_STATUS_ENDPOINT=
PAY_STATUS_METHOD=POST
# Sent as "Authorization: Bearer …" when set.
PAY_AUTH_TOKEN=

# --- M-Pesa fallback (Safaricom Daraja) — only used when PAY_ENDPOINT is blank ---
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill number, or for a Till: the head-office/store number Safaricom gave you
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Set only when collecting into a Buy Goods Till (CustomerBuyGoodsOnline)
MPESA_TILL=
# Public HTTPS URL Safaricom posts results to, ending in /api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback
