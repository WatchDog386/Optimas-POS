{
  "name": "optimas-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first point of sale for a motorbike spare parts shop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
